{
  "_comment": [
    "Where each tracked hook script is wired into ~/.claude/settings.json.",
    "Claude Code's own hooks schema, with one substitution: `script` names a",
    "file in this directory and `agent hooks install` renders it into the",
    "`command` the user's settings need. Nothing here hardcodes ~/.claude, so",
    "CLAUDE_CONFIG_DIR keeps working.",
    "A script with no entry here is installed but never fires -- add it."
  ],
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "script": "require-unstacked-pr.sh",
          "timeout": 10
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "startup|resume|clear",
      "hooks": [
        {
          "type": "command",
          "script": "config-freshness.sh",
          "timeout": 15
        },
        {
          "type": "command",
          "script": "repo-freshness.sh",
          "timeout": 25
        },
        {
          "type": "command",
          "script": "inflight.sh",
          "timeout": 30
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "script": "tmux-title.sh",
          "timeout": 5,
          "async": true
        },
        {
          "type": "command",
          "script": "context-budget.sh",
          "timeout": 5
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "ExitPlanMode",
      "hooks": [
        {
          "type": "command",
          "script": "tmux-title.sh",
          "timeout": 5,
          "async": true
        }
      ]
    }
  ]
}
